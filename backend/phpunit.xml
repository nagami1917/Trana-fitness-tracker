<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="TRANA API">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="APP_DEBUG" value="true"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <!-- Fake conflicting URLs exercise the explicit-field-only configuration. -->
        <env name="DB_URL" value="postgresql://url-host.invalid:6543/url-database" force="true"/>
        <env name="DATABASE_URL" value="postgresql://another-url.invalid:6543/url-database" force="true"/>
        <env name="DB_HOST" value="fields-host.invalid" force="true"/>
        <env name="DB_USERNAME" value="fields-user" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_SSLMODE" value="require" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="LOG_CHANNEL" value="null"/>
        <!-- Password signup ships closed (config/services.php defaults it to
             false), because a deployment whose mailer cannot deliver leaves an
             account that can never be verified and an address that can never be
             reused. The suites that exercise the registration flow do have a
             working transport - the array mailer here, a loopback SMTP capture
             in scripts/test_stateless_api_http.py - so they opt back in
             explicitly. Removing this line would make every registration test
             assert 403 instead of reaching validation. -->
        <env name="TRANA_ALLOW_PASSWORD_SIGNUP" value="true"/>
        <!-- The FastAPI service is faked at the HTTP boundary; see tests/Feature -->
        <env name="ML_API_URL" value="https://ml.test"/>
        <env name="ML_TIMEOUT" value="5"/>
    </php>
</phpunit>
