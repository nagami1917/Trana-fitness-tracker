APP_NAME=TRANA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8001

# Frontend origins allowed to call the API (comma separated)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://trana-web.vercel.app

# ---------------------------------------------------------------------------
# Supabase PostgreSQL — copy exact SESSION POOLER values from Connect.
# Replace the host and username placeholders in your private backend/.env.
# Use only the host (no https://, port, path, brackets, or full URI).
# DB_PASSWORD must be the database password, not an API key. Keep it private.
# The Laravel pgsql connection uses these DB_* fields, not DB_URL or DATABASE_URL.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=YOUR_SESSION_POOLER_HOST
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=YOUR_SESSION_POOLER_USERNAME
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Authentication uses Sanctum personal tokens in HttpOnly cookies.
# Preferred: serve the SPA and the API from one origin (frontend/vercel.json
# rewrites /api to the API project) and keep TRANA_COOKIE_SAME_SITE=lax. The
# cookie is then first-party and works in Brave/Safari/Firefox.
# Only use `none` for an HTTPS cross-site split (separate hosts); browsers that
# block third-party cookies will then be unable to sign in at all.
TRANA_AUTH_COOKIE=trana_session
TRANA_CSRF_COOKIE=trana_csrf
TRANA_AUTH_COOKIE_MINUTES=720
TRANA_COOKIE_SAME_SITE=lax
TRANA_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Google OAuth (Google Cloud OAuth 2.0 Web application credentials).
# Add APP_URL/api/auth/google/callback as an authorized redirect URI in Google.
# Store the real client secret only in this private .env / Vercel environment.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# ---------------------------------------------------------------------------
# Transactional mail for signup verification, password reset, and deletion.
# Gmail SMTP uses an App Password (not your regular Google account password).
# A transactional provider such as Resend/SendGrid may also be used via SMTP.
# Keep MAIL_PASSWORD private in .env / the deployment secret manager.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TRANA

# Password signup needs a working mailer, because every new account must verify
# an emailed code before it can sign in. It is CLOSED by default: with no
# working transport, registration creates the user row and then fails to send,
# leaving an account that can never be verified and an address that can never be
# reused. Set this to true only after a code has actually arrived at a real
# Gmail inbox from this deployment. While it is false the registration form
# answers 403 while Google sign-in and password login keep working; create
# accounts server-side with
# `php artisan account:confirm {email} --name=... --username=...`, which marks
# the address verified so no code is needed.
TRANA_ALLOW_PASSWORD_SIGNUP=false

# ---------------------------------------------------------------------------
# Python ML service (FastAPI). Leave blank to run in "no-prediction" mode.
# ---------------------------------------------------------------------------
ML_API_URL=http://localhost:8000
ML_API_TOKEN=
ML_ADMIN_TOKEN=
ML_TIMEOUT=12
