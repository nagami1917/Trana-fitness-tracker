APP_NAME=TRANA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8001

# Frontend origins allowed to call the API (comma separated)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://trana.vercel.app

# ---------------------------------------------------------------------------
# Supabase PostgreSQL — Trana project (tlqyvjhlesmackmcrzyg).
# The direct host below requires IPv6. For IPv4/serverless, copy the exact
# session-pooler host AND username from Supabase Dashboard → Connect.
# Keep the database password in this ignored .env or your deployment secrets.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db.tlqyvjhlesmackmcrzyg.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Sanctum / auth
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
DEMO_EMAIL=demo@trana.app
DEMO_PASSWORD=trana-demo

# ---------------------------------------------------------------------------
# Python ML service (FastAPI). Leave blank to run in "no-prediction" mode.
# ---------------------------------------------------------------------------
ML_API_URL=http://localhost:8000
ML_API_TOKEN=
ML_TIMEOUT=12
