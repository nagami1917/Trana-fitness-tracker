APP_NAME=TRANA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8001

# Frontend origins allowed to call the API (comma separated)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://trana.vercel.app

# ---------------------------------------------------------------------------
# Supabase PostgreSQL — copy exact SESSION POOLER values from Connect.
# Replace the host and username placeholders in your private backend/.env.
# Use only the host (no https://, port, path, brackets, or full URI).
# DB_PASSWORD must be the database password, not an API key. Keep it private.
# The Laravel pgsql connection uses these DB_* fields, not DB_URL or DATABASE_URL.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=YOUR_SESSION_POOLER_HOST
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=YOUR_SESSION_POOLER_USERNAME
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Sanctum / auth
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
DEMO_EMAIL=demo@trana.app
DEMO_PASSWORD=trana-demo

# ---------------------------------------------------------------------------
# Python ML service (FastAPI). Leave blank to run in "no-prediction" mode.
# ---------------------------------------------------------------------------
ML_API_URL=http://localhost:8000
ML_API_TOKEN=
ML_TIMEOUT=12
