APP_NAME=TRANA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8001

# Frontend origins allowed to call the API (comma separated)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://trana-web.vercel.app

# ---------------------------------------------------------------------------
# Supabase PostgreSQL — copy exact SESSION POOLER values from Connect.
# Replace the host and username placeholders in your private backend/.env.
# Use only the host (no https://, port, path, brackets, or full URI).
# DB_PASSWORD must be the database password, not an API key. Keep it private.
# The Laravel pgsql connection uses these DB_* fields, not DB_URL or DATABASE_URL.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=YOUR_SESSION_POOLER_HOST
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=YOUR_SESSION_POOLER_USERNAME
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Authentication uses Sanctum personal tokens in HttpOnly cookies.
# Production cookies are Secure; use a same-site frontend/API custom domain,
# or set TRANA_COOKIE_SAME_SITE=none for HTTPS cross-site deployments.
TRANA_AUTH_COOKIE=trana_session
TRANA_CSRF_COOKIE=trana_csrf
TRANA_AUTH_COOKIE_MINUTES=720
TRANA_COOKIE_SAME_SITE=lax
TRANA_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Transactional mail for signup verification, password reset, and deletion.
# Gmail SMTP uses an App Password (not your regular Google account password).
# A transactional provider such as Resend/SendGrid may also be used via SMTP.
# Keep MAIL_PASSWORD private in .env / the deployment secret manager.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TRANA

# ---------------------------------------------------------------------------
# Python ML service (FastAPI). Leave blank to run in "no-prediction" mode.
# ---------------------------------------------------------------------------
ML_API_URL=http://localhost:8000
ML_API_TOKEN=
ML_ADMIN_TOKEN=
ML_TIMEOUT=12
