APP_NAME=TRANA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8001

# Frontend origins allowed to call the API (comma separated)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://trana.vercel.app

# ---------------------------------------------------------------------------
# Supabase PostgreSQL — copy exact SESSION POOLER values from Connect.
# Replace the host and username placeholders in your private backend/.env.
# Use only the host (no https://, port, path, brackets, or full URI).
# DB_PASSWORD must be the database password, not an API key. Keep it private.
# The Laravel pgsql connection uses these DB_* fields, not DB_URL or DATABASE_URL.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=YOUR_SESSION_POOLER_HOST
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=YOUR_SESSION_POOLER_USERNAME
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Authentication uses Google Identity Services and Sanctum bearer tokens,
# not stateful cookie sessions. Match this public OAuth client ID with the
# frontend's VITE_GOOGLE_CLIENT_ID. No Google client secret is used or stored.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Transactional email — used only for the account-deletion confirmation code.
# This does not participate in registration or sign-in. Do not use a Gmail/
# Google account password; use a transactional provider credential.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=TRANA

# ---------------------------------------------------------------------------
# Python ML service (FastAPI). Leave blank to run in "no-prediction" mode.
# ---------------------------------------------------------------------------
ML_API_URL=http://localhost:8000
ML_API_TOKEN=
ML_ADMIN_TOKEN=
ML_TIMEOUT=12
