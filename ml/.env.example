# CORS — comma-separated origins allowed to call the ML API (Laravel should be the only one)
ALLOWED_ORIGINS=https://trana.vercel.app
# Shared server-to-server secret; use the same value as Laravel ML_API_TOKEN.
ML_API_TOKEN=
# Shared secret for POST /model/reload after retraining (send as X-Admin-Token)
ADMIN_TOKEN=
# Needed only for `python -m duration_model.train --source supabase`
DATABASE_URL=postgresql://<SESSION_POOLER_USERNAME>:<DATABASE_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=require
# Port the service listens on (Render/Railway/Fly set this automatically)
PORT=8000
