# The Laravel API is always used. Leave blank or use / for same-origin /api;
# alternatively set the deployed Laravel origin when using a separate API host.
VITE_API_BASE_URL=/

# Server-side Vite proxy target (never sent to the browser).
# If Laravel listens on port 8002, use http://127.0.0.1:8002 instead.
VITE_PROXY_TARGET=http://127.0.0.1:8001

# ---------------------------------------------------------------------------
# Map (MapLibre GL JS + OpenStreetMap-based tiles)
# ---------------------------------------------------------------------------
# Full style URL. Defaults to the MapLibre community demo style (OpenStreetMap-
# based, no API key required) when left blank. For production, use your own
# self-hosted or provider style URL here.
VITE_MAP_STYLE_URL=

# Optional provider API key (MapTiler / Stadia Maps / etc.). Only needed when
# VITE_MAP_STYLE_URL points at a provider style that requires a key appended as
# a query parameter. Never commit a real key; set it in your host's secrets.
VITE_MAP_API_KEY=
