# The Laravel API is always used. Leave blank or use / for same-origin /api;
# alternatively set the deployed Laravel origin when using a separate API host.
VITE_API_BASE_URL=/

# Server-side Vite proxy target (never sent to the browser).
# If Laravel listens on port 8002, use http://127.0.0.1:8002 instead.
VITE_PROXY_TARGET=http://127.0.0.1:8001

# ---------------------------------------------------------------------------
# Map (MapLibre GL JS + OpenStreetMap data)
# ---------------------------------------------------------------------------
# Leave all four blank in normal use. The defaults are OpenFreeMap: free,
# keyless, no signup, no request limit, and commercial use is allowed.
# Do NOT point these at tile.openstreetmap.org — that is donated infrastructure
# whose usage policy forbids app-style production traffic:
# https://operations.osmfoundation.org/policies/tiles/
#
# Full MapLibre style URL (default: OpenFreeMap positron vector style).
VITE_MAP_STYLE_URL=

# Style used when the app theme is dark (default: OpenFreeMap dark vector style).
VITE_MAP_DARK_STYLE_URL=

# Optional raster XYZ template for the small Leaflet preview maps
# (Dashboard / Activities). Leave blank to keep them on the vector style.
# Example: https://tile.openstreetmap.fr/hot/{z}/{x}/{y}.png
VITE_MAP_TILE_URL=

# Optional provider API key (MapTiler / Stadia Maps / etc.). Only needed when
# VITE_MAP_STYLE_URL points at a provider style that requires a key appended as
# a query parameter. Never commit a real key; set it in your host's secrets.
VITE_MAP_API_KEY=
